import os
import subprocess

def Git(*args):
  try:
    return subprocess.run(['git', *args], cwd=builder.sourcePath, capture_output=True,
                          text=True, check=True).stdout.strip()
  except (OSError, subprocess.CalledProcessError):
    return None

sdk = sdk_target.sdk
binary = sdk_target.cxx.Library('game_fixes')
cxx = binary.compiler

binary.sources += [
  'src/plugin.cpp',
  'src/scheduler.cpp',
  'src/fixes/fix.cpp',
  'src/fixes/abstract_entity.cpp',
  'src/fixes/beam_crash.cpp',
  'src/fixes/demo_record.cpp',
  'src/fixes/hammer_id.cpp',
  'src/fixes/input_activator_crash.cpp',
