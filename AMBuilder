cxx.cxxincludes += [
  os.path.join(mms_root, 'core'),
  os.path.join(mms_root, 'third_party', 'khook', 'include'),
]

# The version the plugin reports: the release tag and the commit.
cxx.defines += [
  'META_IS_SOURCE2',
  'GITHUB_SHA="{}"'.format(Git('rev-parse', '--short', 'HEAD') or 'Local'),
  'SEMVER="{}"'.format(Git('describe', '--tags', '--exact-match') or 'Local'),
]
cxx.defines += ['SE_{}={}'.format(other['define'], other['code']) for other in SdkHelpers.sdk_manifests]

SdkHelpers.configureCxx(builder, binary, sdk)

if cxx.target.platform == 'linux':
  # Export only CreateInterface
  cxx.linkflags += ['-Wl,--version-script=' + os.path.join(builder.sourcePath, 'ExportMap')]

cxx.linkflags += [dynlibutils[cxx.target.arch]]

cxx.cxxincludes += [
  os.path.join(builder.sourcePath, 'public'),
  os.path.join(builder.sourcePath, 'src'),
  os.path.join(builder.sourcePath, 'vendor'),
  os.path.join(builder.sourcePath, 'vendor', 'dynlibutils', 'include'),
  os.path.join(builder.sourcePath, 'vendor', 'dynlibutils', 'include', 'dynlibutils'),
]

