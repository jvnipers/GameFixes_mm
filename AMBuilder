import os
import subprocess


def Git(*args):
    try:
        return subprocess.run(
            ["git", *args],
            cwd=builder.sourcePath,
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


